(* ::Package:: *)

(* :Title: XML.wl - XML 1.0 documents, read by the grammar of the W3C Recommendation *)
(* :Context: Wolfram`Parser`Languages`XML` *)
(* :Author: Nikolay Murzin, Claude (Anthropic) *)
(* :Summary:
	An XML document as symbolic XML. The parser is generated by EBNFParse from XML.ebnf, the
	productions of the Recommendation as one PEG; its token rules are compiled to regular
	expressions, and its other rules to combinators whose actions build the tree:

		XMLRead["<a x='1'>t<b/></a>"]
			-> XMLObject["Document"][{}, XMLElement["a", {"x" -> "1"}, {"t", XMLElement["b", {}, {}]}], {}]

	Names stay as they are written, prefix and all, and no whitespace is dropped: what a reader
	of one vocabulary makes of namespaces and of whitespace is that reader's, as MathML.wl's is.
*)

BeginPackage["Wolfram`Parser`Languages`XML`", {"Wolfram`Parser`"}]

XMLRead::usage = "XMLRead[\"text\"] reads an XML 1.0 document to symbolic XML: XMLObject[\"Document\"][prolog, element, epilog], an element XMLElement[name, {attribute -> value, ...}, {content, ...}], its content strings, elements, XMLObject[\"Comment\"][text] and XMLObject[\"ProcessingInstruction\"][target, text], names as they are written. The option \"Entities\" gives the entities beyond the five of XML, an Association of names to their text; a reference to an entity it does not have stays in the text between \\[EntityStart] and \\[EntityEnd]. Text that is not a well-formed document gives a Failure."
XMLGrammar::usage = "XMLGrammar[entities] builds the XML parser, from the grammar XMLEBNF, read by EBNFParse, with the entities an Association of names to their text; its value is {prolog, element, epilog}."
XMLEBNF::usage = "XMLEBNF is the grammar of XML 1.0 as the W3C Recommendation publishes it, a string in the classic dialect of EBNFParse."

Begin["`Private`"]

(* ::Section:: *)
(*The grammar: XML.ebnf, read by EBNFParse*)

$xmlDirectory = DirectoryName[$InputFileName]

(* the exact text of a file: Import as "Text" drops a final newline, ReadString leaves UTF-8 undecoded *)
readText[file_String] := ByteArrayToString[ReadByteArray[file], "UTF-8"]

(* read at its first use, so loading the paclet reads no file but its code *)
XMLEBNF := XMLEBNF = readText[FileNameJoin[{$xmlDirectory, "XML.ebnf"}]]

(* the token rules the grammar declares, each a parser of the regular expression it compiles to *)
$xmlTokens := $xmlTokens = With[{trees = Wolfram`Parser`EBNFPrivate`declaredTokenTrees[XMLEBNF]},
	Map[Wolfram`Parser`Private`tokenTreeParser[#, trees["tokenrules"]] &, trees["tokentrees"]]
]

(* what is skipped between a rule's elements: no character *)
$nothing = _ ? (False &)

XMLGrammar[entities_Association] := Module[{parsers},
	parsers = EBNFParse[XMLEBNF,
		"Dialect" -> "Classic",
		"ChoiceMode" -> "PEG",
		"Whitespace" -> $nothing,
		"PrimitiveOverrides" -> $xmlTokens,
		"Actions" -> xmlActions[entities]
	];
	parsers["Document"]
]

(* ::Section:: *)
(*The actions: each rule's value*)

(* what a rule gives where the text breaks a constraint the grammar does not state *)
malformed[template_String, args___] := xmlError[template, {args}]

(* a reference's text, apart from the text written out, which an attribute value normalizes *)
quoted[open_, text_, close_] := text

xmlActions[entities_Association] := <|
	"Document" -> Function[{prolog, element, misc}, {prolog, element, DeleteCases[misc, _String]}],
	"Prolog" -> Function[{declaration, misc, doctype},
		DeleteCases[Flatten[{declaration, misc, Replace[doctype, _Missing -> {}]}], _String | _Missing]
	],
	"XMLDecl" -> Function[{open, version, encoding, standalone, space, close},
		XMLObject["Declaration"] @@ DeleteMissing[{"Version" -> version, "Encoding" -> encoding, "Standalone" -> standalone}, 1, 2]
	],
	"VersionInfo" -> Function[{space, keyword, eq, value}, value[[2]]],
	"EncodingDecl" -> Function[{space, keyword, eq, value}, value[[2]]],
	"SDDecl" -> Function[{space, keyword, eq, value}, value[[2]]],
	"Comment" -> Function[{open, text, close}, XMLObject["Comment"][text]],
	"PI" -> Function[{open, target, text, close}, XMLObject["ProcessingInstruction"][target, If[MissingQ[text], "", Last[text]]]],
	"PITarget" -> Function[name, name],
	"DoctypeDecl" -> Function[{open, space, name, external, more, subset, close},
		XMLObject["Doctype"][name, Sequence @@ If[MissingQ[external], {}, Last[external]], Sequence @@ If[MissingQ[subset], {}, {"InternalSubset" -> subset[[2]]}]]
	],
	"ExternalID" -> Function[Null, Replace[{##}, {{"SYSTEM", _, system_} :> {"System" -> system}, {"PUBLIC", _, public_, _, system_} :> {"Public" -> public, "System" -> system}}]],
	"SystemLiteral" -> quoted,
	"PubidLiteral" -> quoted,
	"Element" -> Function[{open, name, attributes, space, rest}, element[name, Map[Last, attributes], rest]],
	"ETag" -> Function[{open, name, space, close}, name],
	"Attribute" -> Function[{name, eq, value}, name -> value],
	"AttValue" -> Function[{open, parts, close}, StringJoin[Replace[parts, {reference[text_] :> text, text_String :> StringReplace[text, "\t" | "\n" | "\r" -> " "]}, {1}]]],
	"Content" -> Function[Null, content[{##}]],
	"CDSect" -> Function[{open, text, close}, reference[text]],
	"EntityRef" -> Function[{open, name, close}, reference[entityText[entities, name]]],
	"CharRef" -> Function[{open, digits, close}, characterReference[If[open === "&#x", FromDigits[digits, 16], FromDigits[digits]]]]
|>

$xmlEntities = <|"lt" -> "<", "gt" -> ">", "amp" -> "&", "quot" -> "\"", "apos" -> "'"|>

entityText[entities_Association, name_String] := Lookup[$xmlEntities, name, Lookup[entities, name, "\[EntityStart]" <> name <> "\[EntityEnd]"]]

(* [2] Char: the characters a reference may name *)
characterReference[code_Integer] := If[
	code === 9 || code === 10 || code === 13 || 32 <= code <= 55295 || 57344 <= code <= 65533 || 65536 <= code <= 1114111,
	reference[FromCharacterCode[code]],
	malformed["The character reference &#`1`; names no character of XML.", code]
]

(* an element's content: text next to text is one string, a reference's text among it *)
content[items_List] := Map[
	If[MatchQ[First[#], _String | _reference], StringJoin[Replace[#, reference[text_] :> text, {1}]], Splice[#]] &,
	SplitBy[items, MatchQ[_String | _reference]]
]

element[name_String, attributes_List, rest_] := Which[
	! DuplicateFreeQ[Keys[attributes]],
		malformed["The element `1` gives the attribute `2` more than once.", name, First[Keys[Select[Counts[Keys[attributes]], # > 1 &]]]],
	rest === "/>",
		XMLElement[name, attributes, {}],
	rest[[3]] =!= name,
		malformed["The end tag `2` closes the element `1`.", name, rest[[3]]],
	True,
		XMLElement[name, attributes, rest[[2]]]
]

(* ::Section:: *)
(*The document*)

$xmlParsers = <||>
xmlParser[entities_Association] := Lookup[$xmlParsers, Key[entities], $xmlParsers[entities] = XMLGrammar[entities]]

Options[XMLRead] = {"Entities" -> <||>}

XMLRead[text_String, OptionsPattern[]] := With[{r = Parse[xmlParser[OptionValue["Entities"]], text]},
	Which[
		FailureQ[r],
			Failure["XMLRead", <|"MessageTemplate" -> "The text is not a well-formed XML document: `Message`",
				"MessageParameters" -> <|"Message" -> r["Message"]|>, "Position" -> r["Position"]|>],
		! FreeQ[r, _xmlError],
			Replace[FirstCase[r, _xmlError, None, Infinity], xmlError[template_, args_] :>
				Failure["XMLRead", <|"MessageTemplate" -> "The text is not a well-formed XML document: " <> template, "MessageParameters" -> args|>]],
		True,
			XMLObject["Document"] @@ r
	]
]

End[]
EndPackage[]
