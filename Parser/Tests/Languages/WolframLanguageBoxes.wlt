(* :Title: WolframLanguageBoxes.wlt - the front end's boxes of typed text *)
(* :Context: Wolfram`Parser`Languages`WolframLanguage` *)
(* :Summary: WolframLanguageBoxes against the boxes Wolfram 15's front end gives
   FrontEnd`ReparseBoxStructurePacket for the forms of the concrete syntax tree
   tests and the kinds of text the converter sends it, recorded by
   dev/freeze-boxes.wls and frozen here, so that a kernel without a front end
   runs them too. Run via run-tests.wls. *)

ClearAll[$frontEndBoxes, $frontEndOpen]

(* BEGIN frozen: dev/freeze-boxes.wls writes what is between here and END *)
