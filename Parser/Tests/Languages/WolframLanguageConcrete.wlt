    {"f[\n]", CodeParser`ContainerNode[String, {CodeParser`CallNode[{CodeParser`LeafNode[Symbol, "f", <||>]}, CodeParser`GroupNode[CodeParser`GroupSquare, {CodeParser`LeafNode[Token`OpenSquare, "[", <||>], CodeParser`LeafNode[Token`Newline, "\n", <||>], CodeParser`LeafNode[Token`CloseSquare, "]", <||>]}, <||>], <||>]}, <||>]},
    {"f[a, b, c]", CodeParser`ContainerNode[String, {CodeParser`CallNode[{CodeParser`LeafNode[Symbol, "f", <||>]}, CodeParser`GroupNode[CodeParser`GroupSquare, {CodeParser`LeafNode[Token`OpenSquare, "[", <||>], CodeParser`InfixNode[CodeParser`Comma, {CodeParser`LeafNode[Symbol, "a", <||>], CodeParser`LeafNode[Token`Comma, ",", <||>], CodeParser`LeafNode[Whitespace, " ", <||>], CodeParser`LeafNode[Symbol, "b", <||>], CodeParser`LeafNode[Token`Comma, ",", <||>], CodeParser`LeafNode[Whitespace, " ", <||>], CodeParser`LeafNode[Symbol, "c", <||>]}, <||>], CodeParser`LeafNode[Token`CloseSquare, "]", <||>]}, <||>], <||>]}, <||>]},
