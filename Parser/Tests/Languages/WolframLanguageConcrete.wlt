    {"{1,\n2\n\nf[3]", CodeParser`ContainerNode[String, {CodeParser`GroupMissingCloserNode[List, {CodeParser`LeafNode[Token`OpenCurly, "{", <|CodeParser`Source -> {{1, 1}, {1, 2}}|>], CodeParser`LeafNode[Integer, "1", <|CodeParser`Source -> {{1, 2}, {1, 3}}|>], CodeParser`LeafNode[Token`Comma, ",", <|CodeParser`Source -> {{1, 3}, {1, 4}}|>], CodeParser`LeafNode[Token`Newline, "\n", <|CodeParser`Source -> {{1, 4}, {2, 1}}|>], CodeParser`LeafNode[Integer, "2", <|CodeParser`Source -> {{2, 1}, {2, 2}}|>], CodeParser`LeafNode[Token`Newline, "\n", <|CodeParser`Source -> {{2, 2}, {3, 1}}|>], CodeParser`LeafNode[Token`Newline, "\n", <|CodeParser`Source -> {{3, 1}, {4, 1}}|>], CodeParser`LeafNode[Token`Fake`ImplicitTimes, "", <|CodeParser`Source -> {{4, 1}, {4, 1}}|>], CodeParser`LeafNode[Symbol, "f", <|CodeParser`Source -> {{4, 1}, {4, 2}}|>], CodeParser`LeafNode[Token`OpenSquare, "[", <|CodeParser`Source -> {{4, 2}, {4, 3}}|>], CodeParser`LeafNode[Integer, "3", <|CodeParser`Source -> {{4, 3}, {4, 4}}|>], CodeParser`LeafNode[Token`CloseSquare, "]", <|CodeParser`Source -> {{4, 4}, {4, 5}}|>]}, <|CodeParser`Source -> {{1, 1}, {4, 5}}|>]}, <|CodeParser`Source -> {{1, 1}, {4, 5}}|>]},
    {"f[x \n", CodeParser`ContainerNode[String, {CodeParser`CallNode[{CodeParser`LeafNode[Symbol, "f", <|CodeParser`Source -> {{1, 1}, {1, 2}}|>]}, CodeParser`GroupMissingCloserNode[CodeParser`GroupSquare, {CodeParser`LeafNode[Token`OpenSquare, "[", <|CodeParser`Source -> {{1, 2}, {1, 3}}|>], CodeParser`LeafNode[Symbol, "x", <|CodeParser`Source -> {{1, 3}, {1, 4}}|>]}, <|CodeParser`Source -> {{1, 2}, {1, 5}}|>], <|CodeParser`Source -> {{1, 1}, {1, 4}}|>], CodeParser`LeafNode[Whitespace, " ", <|CodeParser`Source -> {{1, 4}, {1, 5}}|>], CodeParser`LeafNode[Token`Newline, "\n", <|CodeParser`Source -> {{1, 5}, {2, 1}}|>]}, <|CodeParser`Source -> {{1, 1}, {2, 1}}|>]},
    {"(* abc\n", CodeParser`ContainerNode[String, {CodeParser`ErrorNode[Token`Error`UnterminatedComment, "(* abc", <|CodeParser`Source -> {{1, 1}, {1, 7}}|>]}, <|"EmbeddedNewlines" -> {{1, 1}}, CodeParser`Source -> {{1, 1}, {2, 1}}|>]},
    {"\"abc\n", CodeParser`ContainerNode[String, {CodeParser`ErrorNode[Token`Error`UnterminatedString, "\"abc", <|CodeParser`Source -> {{1, 1}, {1, 5}}|>]}, <|"EmbeddedNewlines" -> {{1, 1}}, CodeParser`Source -> {{1, 1}, {2, 1}}|>]},
    {"a = 1\nb = (c", CodeParser`ContainerNode[String, {CodeParser`BinaryNode[Set, {CodeParser`LeafNode[Symbol, "a", <|CodeParser`Source -> {{1, 1}, {1, 2}}|>], CodeParser`LeafNode[Whitespace, " ", <|CodeParser`Source -> {{1, 2}, {1, 3}}|>], CodeParser`LeafNode[Token`Equal, "=", <|CodeParser`Source -> {{1, 3}, {1, 4}}|>], CodeParser`LeafNode[Whitespace, " ", <|CodeParser`Source -> {{1, 4}, {1, 5}}|>], CodeParser`LeafNode[Integer, "1", <|CodeParser`Source -> {{1, 5}, {1, 6}}|>]}, <|CodeParser`Source -> {{1, 1}, {1, 6}}|>], CodeParser`LeafNode[Token`Newline, "\n", <|CodeParser`Source -> {{1, 6}, {2, 1}}|>], CodeParser`BinaryNode[Set, {CodeParser`LeafNode[Symbol, "b", <|CodeParser`Source -> {{2, 1}, {2, 2}}|>], CodeParser`LeafNode[Whitespace, " ", <|CodeParser`Source -> {{2, 2}, {2, 3}}|>], CodeParser`LeafNode[Token`Equal, "=", <|CodeParser`Source -> {{2, 3}, {2, 4}}|>], CodeParser`LeafNode[Whitespace, " ", <|CodeParser`Source -> {{2, 4}, {2, 5}}|>], CodeParser`GroupMissingCloserNode[CodeParser`GroupParen, {CodeParser`LeafNode[Token`OpenParen, "(", <|CodeParser`Source -> {{2, 5}, {2, 6}}|>], CodeParser`LeafNode[Symbol, "c", <|CodeParser`Source -> {{2, 6}, {2, 7}}|>]}, <|CodeParser`Source -> {{2, 5}, {2, 7}}|>]}, <|CodeParser`Source -> {{2, 1}, {2, 7}}|>]}, <|CodeParser`Source -> {{1, 1}, {2, 7}}|>]},
    {"f[x\nBegin[\"a`\"]", CodeParser`ContainerNode[String, {CodeParser`CallNode[{CodeParser`LeafNode[Symbol, "f", <|CodeParser`Source -> {{1, 1}, {1, 2}}|>]}, CodeParser`GroupMissingCloserNode[CodeParser`GroupSquare, {CodeParser`LeafNode[Token`OpenSquare, "[", <|CodeParser`Source -> {{1, 2}, {1, 3}}|>], CodeParser`LeafNode[Symbol, "x", <|CodeParser`Source -> {{1, 3}, {1, 4}}|>]}, <|CodeParser`Source -> {{1, 2}, {1, 4}}|>], <|CodeParser`Source -> {{1, 1}, {2, 12}}|>]}, <|CodeParser`Source -> {{1, 1}, {2, 12}}|>]},
    {"f[x\\\n", CodeParser`ContainerNode[String, {CodeParser`CallNode[{CodeParser`LeafNode[Symbol, "f", <|CodeParser`Source -> {{1, 1}, {1, 2}}|>]}, CodeParser`GroupMissingCloserNode[CodeParser`GroupSquare, {CodeParser`LeafNode[Token`OpenSquare, "[", <|CodeParser`Source -> {{1, 2}, {1, 3}}|>], CodeParser`LeafNode[Symbol, "x", <|CodeParser`Source -> {{1, 3}, {1, 4}}|>]}, <|CodeParser`Source -> {{1, 2}, {1, 5}}|>], <|CodeParser`Source -> {{1, 1}, {1, 4}}|>]}, <|"SimpleLineContinuations" -> {{1, 4}}, CodeParser`Source -> {{1, 1}, {1, 4}}|>]},
    {"\"abc\\\n", CodeParser`ContainerNode[String, {CodeParser`ErrorNode[Token`Error`UnterminatedString, "\"abc\\", <|CodeParser`Source -> {{1, 1}, {1, 6}}|>]}, <|"SimpleLineContinuations" -> {{1, 5}}, CodeParser`Source -> {{1, 1}, {1, 5}}|>]},
    {"\"a\\\nb\\\n", CodeParser`ContainerNode[String, {CodeParser`ErrorNode[Token`Error`UnterminatedString, "\"a\\\nb\\", <|CodeParser`Source -> {{1, 1}, {2, 3}}|>]}, <|"SimpleLineContinuations" -> {{2, 2}}, "ComplexLineContinuations" -> {{1, 1}}, CodeParser`Source -> {{1, 1}, {2, 2}}|>]}
};
(* END frozen *)

(* === each form's tree === *)
Scan[
    Function[c, VerificationTest[noSource[WolframLanguageConcrete[c[[1]]]], c[[2]], TestID -> "concrete: " <> c[[1]]]],
    $concreteTrees]

(* === whole containers, Source included === *)
Scan[
    Function[c, VerificationTest[WolframLanguageConcrete[c[[1]]], c[[2]], TestID -> "concrete with Source: " <> c[[1]]]],
    $concreteContainers]

(* === the zoo's sources: every character in a leaf, in order === *)
leafText[tree_] := StringJoin[Cases[tree, (CodeParser`LeafNode | CodeParser`ErrorNode)[_, s_String, _] :> s, Infinity]]
$concreteZoo = FileNames["*.wl", FileNameJoin[{PacletObject["Wolfram/Parser"]["Location"], "Kernel", "Languages"}]];
Scan[
    Function[f, With[{s = ByteArrayToString[ReadByteArray[f], "UTF-8"]},
        VerificationTest[leafText[WolframLanguageConcrete[s]], s, TestID -> "concrete: the leaves of " <> FileNameTake[f] <> " hold its text"]]],
    $concreteZoo]

(* === a file === *)
VerificationTest[
    With[{f = First[$concreteZoo]}, With[{c = WolframLanguageConcrete[File[f]]},
        {c[[1]], c[[3, "FileName"]], c[[2]] === WolframLanguageConcrete[ByteArrayToString[ReadByteArray[f], "UTF-8"]][[2]]}]],
    {File, ExpandFileName[First[$concreteZoo]], True},
    TestID -> "concrete: a file's container is a File one naming it, its tree that of its text"]

(* === CodeParser's own symbols === *)
VerificationTest[
    Union[Context /@ Cases[WolframLanguageConcrete["f[x_] := x + 1"], h_[_, _, _Association] :> h, {0, Infinity}]],
    {"CodeParser`"},
    TestID -> "concrete: the nodes are CodeParser's"]

(* === source that is not Wolfram Language === *)
VerificationTest[
    Head[WolframLanguageConcrete["f[x, ]]) ?? \"abc"]],
    CodeParser`ContainerNode,
    TestID -> "concrete: what is not Wolfram Language reads, and nothing fails"]
