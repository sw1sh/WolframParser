(* :Title: WolframLanguageConcrete.wlt - concrete syntax tree tests *)
(* :Context: Wolfram`Parser`Languages`WolframLanguage` *)
(* :Summary: WolframLanguageConcrete against what Wolfram 15's
   CodeParser`CodeConcreteParse gives, recorded by dev/freeze-concrete.wls
   and frozen here, so that a kernel without CodeParser runs them too: each
   form's tree with Source dropped, source that is not Wolfram Language
   among them, and whole containers with Source and the container's lists.
   Then the zoo's sources kept whole in the leaves, a file, and source that
   reads though it is no Wolfram Language. Run via run-tests.wls. *)

ClearAll[$concreteTrees, $concreteContainers, $concreteZoo, noSource, leafText]

noSource[t_] := t /. a_Association :> KeyDrop[a, CodeParser`Source]

(* BEGIN frozen: dev/freeze-concrete.wls writes what is between here and END *)
$concreteTrees = {
    {"a", CodeParser`ContainerNode[String, {CodeParser`LeafNode[Symbol, "a", <||>]}, <||>]},
    {"f[x]", CodeParser`ContainerNode[String, {CodeParser`CallNode[{CodeParser`LeafNode[Symbol, "f", <||>]}, CodeParser`GroupNode[CodeParser`GroupSquare, {CodeParser`LeafNode[Token`OpenSquare, "[", <||>], CodeParser`LeafNode[Symbol, "x", <||>], CodeParser`LeafNode[Token`CloseSquare, "]", <||>]}, <||>], <||>]}, <||>]},
